<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.maxtrezzi</groupId>
    <artifactId>modelrack4j-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>modelrack4j-examples</artifactId>
  <name>modelrack4j :: examples</name>
  <description>Runnable demos, including the SL/SH/CR scenario. Deliberately NOT published.</description>

  <properties>
    <!--
      Never published, but it still needs its OWN module name: inheriting the parent's
      default gave this jar the same Automatic-Module-Name as core, and javadoc then failed
      to resolve core's types at all — two automatic modules cannot share a name.
    -->
    <automatic.module.name>io.github.maxtrezzi.modelrack4j.examples</automatic.module.name>
    <!--
      Per the module layout: examples are never published.

      Two properties, because they cover two different builds. maven.deploy.skip stops an
      ordinary `mvn deploy`. Under -Prelease it stops nothing: the Central publishing plugin
      runs with <extensions>true</extensions> and its lifecycle participant removes
      maven-deploy-plugin from the build entirely, so no code reads that property any more.
      skipPublishing is the parameter the publishing plugin itself reads (per-module since
      its 0.9.0). Removing either one publishes this module to Maven Central by accident.
    -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <skipPublishing>true</skipPublishing>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-core</artifactId>
    </dependency>
    <!--
      Providers are on the runtime classpath so ServiceLoader can find them. This is exactly
      what a consumer does: core alone knows no providers at all.
    -->
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-provider-openai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.maxtrezzi</groupId>
      <artifactId>modelrack4j-provider-anthropic</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Demos print through SLF4J's simple binding; the library itself binds nothing. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.18</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
