# Local-only planning material — never commit
brainstorm/

# Local configuration and credentials — this library's whole domain is config files that
# hold API keys, so the ignore list is deliberately wider than the files we happen to use.
local.conf
*.local.conf
.env
.env.*
application-local.*
**/secrets.*

# Key material — never commit, and never rely on remembering not to.
#
# On 2026-08-30 the GPG backup commands for the release key were run from inside this
# checkout, so `chiave-privata.asc` and the revocation certificate landed in the working tree
# of a PUBLIC repository as untracked but NOT ignored files — one `git add -A` from being
# staged. They never reached a git object, and the rule below is why it cannot happen twice.
# No file of these kinds belongs in this repository, so the list is deliberately wide.
*.asc
*.gpg
*.pgp
*.rev
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
secring.*
gpg-backup*/

# Personal Claude Code settings. The shared .claude/settings.json is committable; this one
# is per-machine, and was previously ignored only by the author's global ignore file —
# which does not travel to anyone else's checkout.
.claude/settings.local.json

# Maven
target/

# Python bytecode. build/check-docs.py is a script, not a package — running it, or
# py_compile'ing it during a review, leaves a __pycache__ that has no business being
# tracked. One got committed in #28 before this rule existed.
__pycache__/
*.py[cod]

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
