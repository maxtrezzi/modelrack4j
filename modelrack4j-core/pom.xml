<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.maxtrezzi</groupId>
    <artifactId>modelrack4j-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>modelrack4j-core</artifactId>
  <name>modelrack4j :: core</name>
  <description>Registry, layered HOCON config loading, validation and file watching.</description>

  <properties>
    <!--
      ADR-0041: mutation testing lives in this module alone, so its versions are pinned here
      rather than in the parent — a parent declaration would inherit PIT into every module,
      the four provider ones included, whose tests reach real APIs under -Pintegration. PIT
      runs the covering tests once per mutant.
    -->
    <pitest.version>1.30.0</pitest.version>
    <pitest.junit5.version>1.2.3</pitest.junit5.version>
  </properties>

  <dependencies>
    <!-- ADR-0005: core takes no provider artifact, ever. -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
    </dependency>
    <!--
      ADR-0020: ChatMemoryProvider is NOT in langchain4j-core, so core also takes the
      aggregate. opennlp-tools is excluded: it is referenced by one class in that jar,
      DocumentBySentenceSplitter, which is out-of-scope RAG splitting (ADR-0003).
    -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.apache.opennlp</groupId>
          <artifactId>opennlp-tools</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- ADR-0007: layered HOCON. -->
    <dependency>
      <groupId>com.typesafe</groupId>
      <artifactId>config</artifactId>
    </dependency>
    <!--
      Already on the classpath through langchain4j-core, but the watcher logs directly, and
      a dependency that is used is a dependency that is declared. API only: binding is the
      application's choice, as it already is for LangChain4j itself.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        PIT is never bound to a lifecycle phase: it runs only when its goal is named on the
        command line.

            mvn -pl modelrack4j-core org.pitest:pitest-maven:mutationCoverage

        Report in target/pit-reports/.
      -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <!-- `*` is not recursive, so the spi package needs its own line. -->
            <param>io.github.maxtrezzi.modelrack4j.*</param>
            <param>io.github.maxtrezzi.modelrack4j.spi.*</param>
          </targetClasses>
          <excludedClasses>
            <!--
              The watcher is the one class built on WatchService and a 300 ms debounce.
              Mutating it yields timeouts rather than information. The trailing `*` is
              load-bearing: the filtering lives in the nested WatchedDirectory class, which
              a bare class name does not match.
            -->
            <param>io.github.maxtrezzi.modelrack4j.ConfigWatcher*</param>
          </excludedClasses>
          <excludedMethods>
            <!--
              toString is a debugging aid, not a contract. Killing its mutants would mean
              asserting on a format nothing promises, which pins it against every later
              improvement for no gain.
            -->
            <param>toString</param>
          </excludedMethods>
          <timeoutConstant>6000</timeoutConstant>
          <!--
            ADR-0041: the score is not a gate. What this run produces is the list of
            surviving mutants, each of which is a question about the tests; failing the
            build on a number would reward assertions written to raise it.
          -->
          <mutationThreshold>0</mutationThreshold>
          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
          </outputFormats>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
